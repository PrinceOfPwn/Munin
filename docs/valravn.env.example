# Core runtime and budgets
VALRAVN_MAX_WORKERS=8
VALRAVN_MAX_OUTPUT_CHARS=180000
VALRAVN_RESOLVE_PUBLIC_HOSTS=true
VALRAVN_HTTP_CONNECT_TIMEOUT=5
VALRAVN_HTTP_READ_TIMEOUT=30
VALRAVN_USAGE_MODE=commercial
VALRAVN_NO_KEY_QUICK_BUDGET=3
VALRAVN_NO_KEY_DEEP_BUDGET=8
VALRAVN_FREE_KEY_QUICK_BUDGET=2
VALRAVN_FREE_KEY_DEEP_BUDGET=6
VALRAVN_SCARCE_QUICK_BUDGET=0
VALRAVN_SCARCE_DEEP_BUDGET=1

# Vulnerability intelligence
NVD_API_KEY=
GITHUB_TOKEN=

# Threat intelligence
OTX_API_KEY=
ABUSECH_AUTH_KEY=
ABUSEIPDB_API_KEY=
VT_API_KEY=

# Internet reconnaissance
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
ZOOMEYE_API_KEY=
LEAKIX_API_KEY=
NETLAS_API_KEY=
URLSCAN_API_KEY=
CLOUDFLARE_RADAR_TOKEN=
FULLHUNT_API_KEY=

# High-cost / active operations are opt-in
VALRAVN_URLSCAN_SUBMIT_ENABLED=false
VALRAVN_CLOUDFLARE_URL_SCAN_ENABLED=false
VALRAVN_FULLHUNT_ENABLED=false

# Safe Browsing: non-commercial only
GOOGLE_SAFE_BROWSING_API_KEY=
VALRAVN_SAFE_BROWSING_ENABLED=false

# Optional isolated URL scanner
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_URL_SCANNER_TOKEN=

# Browser and Tor2Web gateway
VALRAVN_BROWSER_ENABLED=false
VALRAVN_BROWSER_HEADLESS=true
VALRAVN_BROWSER_PROXY=
VALRAVN_DARKWEB_SEARCH_ENABLED=true
VALRAVN_ONION_GATEWAY_DOMAIN=onion.pet
CLOAKBROWSER_LICENSE_KEY=

# Translation
GOOGLE_TRANSLATE_API_KEY=
