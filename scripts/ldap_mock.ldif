# Munin Mock LDAP — dominio dc=akatsuki,dc=com
#
# Contiene usuarios, service accounts, grupos privilegiados y OUs.
# Las señales de vulnerabilidad (SPNs, DONT_REQ_PREAUTH) están codificadas
# en atributos ESTRUCTURADOS (title, employeeType, businessCategory), no en
# descripciones en texto libre. El LLM debe inferir las condiciones ofensivas
# ejecutando las tools LDAP y examinando los atributos — no leyendo prosa.
#
# Convención del mock (compatible con OpenLDAP inetOrgPerson):
#   title            → placeholder para servicePrincipalName (SPN)
#   employeeType     → placeholder para userAccountControl flags
#   businessCategory → placeholder para admin flags (opcional)
#
# Cargar con:
#   ldapadd -H ldap://localhost:389 -x -D "cn=admin,dc=akatsuki,dc=com" -w itachi -f ldap_mock.ldif

# ── Organizational Units ──────────────────────────────────────────────────────

dn: ou=users,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: users
description: Domain users

dn: ou=groups,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: groups
description: Domain groups

dn: ou=computers,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: computers
description: Domain computers

dn: ou=service-accounts,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: service-accounts
description: Service and machine accounts

# ── Regular users ─────────────────────────────────────────────────────────────

dn: uid=jdoe,ou=users,dc=akatsuki,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: jdoe
cn: John Doe
sn: Doe
givenName: John
mail: jdoe@akatsuki.com
uidNumber: 1001
gidNumber: 1001
homeDirectory: /home/jdoe
loginShell: /bin/bash
title: Senior Engineer
ou: IT

