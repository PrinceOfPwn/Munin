# Enterprise OpenLDAP Mock Directory — Domain: dc=akatsuki,dc=com
#
# Realistically modeled enterprise Active Directory / OpenLDAP directory tree.
# Designed for testing threat intelligence agents, LDAP discovery, and security evaluation.
#
# Structured Vulnerability Markers:
#   title        → SPN placeholder (e.g. MSSQLSvc/sql01.akatsuki.com:1433)
#   employeeType → UserAccountControl flag (e.g. DONT_REQ_PREAUTH)
#
# Load into OpenLDAP:
#   ldapadd -H ldap://localhost:389 -x -D "cn=admin,dc=akatsuki,dc=com" -w itachi -f scripts/ldap_mock.ldif

# ── Top-Level Organizational Units ───────────────────────────────────────────

dn: ou=users,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: users
description: Domain Users Container

