objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: shadowAccount
uid: administrator
cn: Domain Administrator
sn: Administrator
givenName: Domain
mail: administrator@akatsuki.com
uidNumber: 500
gidNumber: 512
homeDirectory: /home/administrator
loginShell: /bin/bash
title: System Administrator
ou: IT

# ── Service Accounts ─────────────────────────────────────────────────────────
# SPNs encoded in the `title` attribute (real AD stores them in
# servicePrincipalName). Pattern `<SERVICE>/<HOST>:<PORT>` — the tools search
# for this pattern to identify kerberoastable accounts, mimicking the real
# `servicePrincipalName=*` filter.

dn: uid=svc_backup,ou=service-accounts,dc=akatsuki,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
uid: svc_backup
cn: Backup Service Account
sn: svc_backup
mail: svc_backup@akatsuki.com
uidNumber: 2001
gidNumber: 2000
homeDirectory: /var/lib/backup
loginShell: /bin/false
title: MSSQLSvc/DBSERVER01.akatsuki.com:1433

