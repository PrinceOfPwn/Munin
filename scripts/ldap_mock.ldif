# Enterprise OpenLDAP Mock Directory — Domain: dc=akatsuki,dc=com
#
# Advanced Enterprise Active Directory / OpenLDAP Directory Tree.
# Designed for testing threat intelligence agents, LDAP discovery, and complex privilege escalation paths.
#
# Vulnerability Vectors:
#   - Kerberoastable Accounts: Service accounts with SPNs encoded in `title` (e.g. MSSQLSvc/sql01.akatsuki.com:1433)
#   - AS-REP Roastable Users: Accounts with pre-authentication disabled (`employeeType: DONT_REQ_PREAUTH`)
#   - Nested Group Delegation: Indirect escalation paths (e.g. Helpdesk → Server Operators → Domain Admins)
#
# Load into OpenLDAP:
#   ldapadd -H ldap://localhost:389 -x -D "cn=admin,dc=akatsuki,dc=com" -w itachi -f scripts/ldap_mock.ldif

# ── Top-Level Containers & Organizational Units ──────────────────────────────

dn: ou=users,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: users
description: Legacy Users Container

dn: ou=groups,dc=akatsuki,dc=com
objectClass: organizationalUnit
ou: groups
description: Legacy Security Groups Container

dn: ou=computers,dc=akatsuki,dc=com
objectClass: organizationalUnit
