# ============================================================================
# Munin — .env.example
# Copiar a `.env` y completar. Todos los secretos quedan en env; nunca en git.
# ============================================================================

# --- LLM (endpoint OpenAI-compatible: NVIDIA NIM, OpenAI, Groq, vLLM, Ollama…)
LLM_BASE_URL=https://<your-mimo-endpoint>/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL=mimo-v2-flash
LLM_TIMEOUT_FLOOR=40
LLM_TIMEOUT_CEILING=240
# auto follows the latest operator message. Examples: es, en, zh-CN.
MUNIN_OPERATOR_LANGUAGE=auto

# --- LDAP (target del lab)
LDAP_URI=ldap://localhost:389
LDAP_BASE_DN=dc=akatsuki,dc=com
LDAP_BIND_DN=cn=admin,dc=akatsuki,dc=com
LDAP_PASSWORD=itachi

# --- Passive intel
TAVILY_API_KEY=
NVD_API_KEY=
GITHUB_TOKEN=

# --- Hugin (base de conocimiento externa)
HUGIN_URL=https://raw.githubusercontent.com/PrinceOfPwn/Hugin/main/hugin/graph.json
HUGIN_TTL_SECONDS=900

# --- MCP transport (streamable-http)
MUNIN_MCP_AUTH_TOKEN=change-me-generate-with-openssl-rand-hex-32
MUNIN_MCP_HOST=127.0.0.1
MUNIN_MCP_PORT=8890
# Allow HTTP transport to start WITHOUT an auth token. Dev only — never in
# runner or production. When unset AND token empty, Munin refuses to start.
# MUNIN_MCP_ALLOW_ANON=0

# --- ReAct loop
# Iteration budget. Blank / unset = effectively unbounded (HARD_CEILING=10000).
# The default operational budget is 60; set a low number here for tight tests.
MUNIN_MAX_ITERATIONS=60

# --- Server logging
# One of DEBUG | INFO | WARNING | ERROR. Default INFO.
MUNIN_LOG_LEVEL=INFO

# ============================================================================
# Persistence — how Munin's state survives across sessions
# ============================================================================
#
# Three modes:
#
# 1. Local file SQLite (default): everything lives in $MUNIN_DATA_PATH/
#    shared_state.sqlite. Ephemeral in a runner unless the workflow uploads
#    it as an artifact (which it does with persist_state=true).
#
# 2. libsql / Turso (opt-in): set MUNIN_DB_URL. Free tier at turso.tech.
#    Enables real multi-session persistence + concurrent sessions safely.
#    Uses the official `libsql` package with a direct remote autocommit
#    connection; a runner-local replica is not required for persistence.
#
# 3. Explicit local file path: set MUNIN_DB_URL=file:/absolute/path.
#
# Examples (all commented — pick one at most):
# MUNIN_DB_URL=libsql://xxxx.turso.io
# MUNIN_DB_AUTH_TOKEN=eyJhbGci...
# MUNIN_DB_URL=file:/var/lib/munin/state.sqlite
MUNIN_DB_URL=
MUNIN_DB_AUTH_TOKEN=

# --- Production Suite boundary (operator UI / durable Turso aggregate)
# Production API refuses a file:// database. It isolates its aggregate in
# production_ tables, so it may share the authoritative Turso DB with MCP or
# use a separate Turso DB when stronger operational isolation is desired.
# Generate a 32-byte key outside the repository, e.g. a KMS secret. This key
# encrypts per-profile DEKs; browser clients never receive it.
MUNIN_MASTER_KEY=
MUNIN_ALLOWED_ORIGINS=https://munin.example.com
MUNIN_COOKIE_SECURE=1
MUNIN_PRODUCTION_AUTO_DISPATCH=1
# Next.js server-side proxy target, not NEXT_PUBLIC. It must be reachable only
# from the app server/network boundary.
MUNIN_PRODUCTION_API_URL=http://127.0.0.1:8787
# Page Agent is deny-by-default. Its authenticated proxy only returns typed,
# allowlisted UI action plans and never exposes provider credentials.
MUNIN_PAGE_AGENT_ENABLED=0
# Native provider reasoning is opt-in for persistence. Operational summaries
# remain available without storing provider thinking fields.
MUNIN_REASONING_PERSISTENCE=0
# Optional durable Discord identity mapping. This must be an existing Munin
# operator user ID; Discord cannot create or impersonate users.
MUNIN_DISCORD_DURABLE_ACTOR_ID=
MUNIN_DISCORD_CONVERSATION_ID=

# --- Auto-commit forged artifacts back to the repo (runner mode)
# When MUNIN_AUTO_COMMIT=1, tool_forge & graph_forge push their outputs to a
# session branch so Munin evolves from one run to the next. Local dev keeps
# this off so it doesn't dirty your working tree.
MUNIN_AUTO_COMMIT=0
MUNIN_GIT_USER=munin-bot
MUNIN_GIT_EMAIL=munin-bot@users.noreply.github.com
# Blank = use current branch. Workflow sets this to munin/session-<run_id>.
# MUNIN_GIT_BRANCH=
# Stable owner id for cross-host presence leases. The workflow provides a
# unique value per run/attempt and passes it to every spawned runner.
# MUNIN_INSTANCE_ID=

# --- Auto-PR for soul edits (runner mode)
# When MUNIN_AUTO_PR=1 and `gh` CLI is available, soul_propose_edit opens a
# labeled PR on top of the local file drop. Local dev leaves off.
MUNIN_AUTO_PR=0
# Soul proposal worktrees are based on this branch, never the live session HEAD.
MUNIN_PR_BASE_BRANCH=main

# --- Discord operator bridge (optional)
# The bot only accepts prefixed inbound messages from explicit numeric user IDs.
# Use `munin, <request>` in the configured channel. Keep the token out of git.
MUNIN_DISCORD_TOKEN=
MUNIN_DISCORD_CHANNEL_ID=
MUNIN_DISCORD_GUILD_ID=
MUNIN_DISCORD_ALLOWED_USER_IDS=
MUNIN_DISCORD_PREFIX=munin
MUNIN_DISCORD_MAX_ITERATIONS=60

# --- Self-extension governance
# extension_forge validates a proposal; extension_open_pr additionally requires
# operator_approved=true. It never merges a PR.
MUNIN_EXTENSION_AUTO_PR=0

# ============================================================================
# OPSEC (OFFX legacy + Munin policy)
# ============================================================================

# always | active_only | off
PREFLIGHT_POLICY=active_only
OFFX_EXPECTED_EGRESS_IP=
OFFX_FORBIDDEN_EGRESS_IP=
OFFX_ROUTE_PROBE_IP=1.1.1.1
OFFX_TIMEOUT=300
OFFX_MAX_OUTPUT_CHARS=32000
OFFX_JOB_WORKERS=5

# --- Munin paths
MUNIN_SOUL_PATH=./soul
MUNIN_DATA_PATH=./data
