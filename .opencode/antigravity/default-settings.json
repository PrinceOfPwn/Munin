{
  "artifactReviewPolicy": "always-proceed",
  "allowNonWorkspaceAccess": false,
  "permissions": {
    "allow": [
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git grep)",
      "command(git ls-files)",
      "command(python -m pytest)",
      "command(python3 -m pytest)",
      "command(pytest)",
      "command(uv run pytest)",
      "command(ruff)",
      "command(mypy)",
      "command(pyright)",
      "command(npm test)",
      "command(npm run (test|lint|build|typecheck))",
      "command(npx (eslint|tsc|vitest|jest))",
      "command(pnpm (test|lint|build|typecheck))",
      "command(pnpm run (test|lint|build|typecheck))",
      "command(bun test)",
      "command(bun run (test|lint|build|typecheck))",
      "command(node)",
      "command(rg)",
      "command(grep)"
    ],
    "deny": [
      "command(git add)",
      "command(git commit)",
      "command(git push)",
      "command(git reset)",
      "command(git clean)",
      "command(git checkout)",
      "command(git restore)",
      "command(git switch)",
      "command(git stash)",
      "command(git rebase)",
      "command(git merge)",
      "command(rm -rf)",
      "command(sudo)",
      "command(chmod)",
      "command(chown)",
      "command(powershell Remove-Item)",
      "command(pwsh Remove-Item)",
      "write_file(.git/)"
    ],
    "ask": []
  }
}
